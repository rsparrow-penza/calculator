# Dockerfile бэкенда: Flask + gunicorn
#
# Этап сборки минимальный: нам нужен только интерпретатор и зависимости.

# Официальный лёгкий образ Python (slim = без «всего подряд», меньше размер)
FROM python:3.12-slim

# Все файлы приложения положим в /app внутри контейнера
WORKDIR /app

# Сначала ставим зависимости, и только потом копируем код.
# Порядок важен: слой с pip install кэшируется Docker, и при правке app.py
# пересборка занимает секунды, а не минуты.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt gunicorn

COPY app.py .

# gunicorn — «настоящий» сервер для запуска Flask в продакшене
# (встроенный сервер Flask однопоточный и не предназначен для интернета).
# 8000 — порт внутри контейнера; наружу его видно не будет,
# nginx-фронтенд достанется до него по внутренней сети Docker.
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "2", "app:app"]
